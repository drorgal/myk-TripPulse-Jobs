# PostgreSQL
DATABASE_URL="postgresql://trippulse:localdev@localhost:5432/trippulse_jobs"
POSTGRES_PASSWORD=localdev

# Redis
REDIS_URL="redis://:localdev@localhost:6379"
REDIS_PASSWORD=localdev

# API Server
API_PORT=3000
NODE_ENV=development

# Logging (debug | info | warn | error)
LOG_LEVEL=debug

# Worker
WORKER_CONCURRENCY=5
WORKER_METRICS_PORT=9091

# ── RentalCars Provider ────────────────────────────────────────────────────
# Leave blank to disable the real provider (mock will still run).
# See docs/RENTALCARS_SETUP.md for how to get these values.
RENTALCARS_API_KEY=
RENTALCARS_API_URL=
RENTALCARS_AFFILIATE_ID=
RENTALCARS_TIMEOUT_MS=10000
